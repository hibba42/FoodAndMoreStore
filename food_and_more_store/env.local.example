# Copy this file to ".env.local" for local development
# (used by `npm run dev` and `npx drizzle-kit pull`).
# Use the same user, password and database name as in ".env".
# Avoid characters like @ / : # in the password, or URL-encode them.
DATABASE_URL=postgres://foodstore:change-me-to-match-your-env-file@localhost:5432/foodstore

# Only set this once the site is served over HTTPS (e.g. behind a reverse proxy).
# A "Secure" cookie is never sent over plain http://, which would break the cart.
# COOKIE_SECURE=true
