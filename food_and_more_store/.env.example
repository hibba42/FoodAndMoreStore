# Copy to ".env" (never commit the real one) and fill in the values.
# Docker Compose reads this file.

# --- Database ---
POSTGRES_USER=foodstore
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=foodstore

# --- Accounts (Better Auth) ---
# A long random string used to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address you open the site at in your browser.
BETTER_AUTH_URL=http://localhost:3000

# Optional: other addresses the site may be opened from (comma-separated),
# e.g. a LAN address. Leave empty if you only use the URL above.
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional: set to true once the site is served over HTTPS.
COOKIE_SECURE=false
